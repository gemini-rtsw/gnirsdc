# Modified to exclude certain files from CC, WFS, ENG, LIB and GNAAC on
# "gmake release".
#
# Also modified to keep "colors.adl" and "template.adl".
#
# 27 May 1997: NIRS version.
#

# ---------------------------------------------------------------------------
# Zero-setup build: plain `make` builds DC2 (gnirsdc-2-vme) in a fresh
# checkout. config/CONFIG.Defs and the .applTop/.epics links are generated by
# tools/linux-build/setup-dc2.sh, because the EPICS 3.12 applSetup bakes the
# checkout's ABSOLUTE path into them. Run setup before anything is included
# when that state is missing, or when the checkout has moved (APPLIC_INSTALL
# no longer names this directory). DC1 builds separately: make -C ppc.
ifneq ($(shell sed -n 's/^APPLIC_INSTALL *= *//p' config/CONFIG.Defs 2>/dev/null),$(CURDIR))
  $(info DC2 setup: running tools/linux-build/setup-dc2.sh)
  $(if $(shell ./tools/linux-build/setup-dc2.sh >&2 && echo ok),,$(error setup-dc2.sh failed))
endif

# DC2 builds only against GEM5. Set the environment UNCONDITIONALLY: the
# pipeline's build container carries ADE's EPICS 3.14 environment, which must
# not win. Same values as /etc/profile.d/gem5.sh.
export EPICS            := /usr/software/dev/packages/epics/epics3.12.2GEM5
export EPICS_BASE       := $(EPICS)/base
export EPICS_EXTENSIONS := $(EPICS)/extensions
export HOST_ARCH        := Linux
export TARGET_ARCH      := 68k
export VX_DIR           := /usr/software/dev/packages/vxworks/v5.2b
unexport GCC_EXEC_PREFIX
export PATH := $(VX_DIR)/gnu/$(HOST_ARCH).$(TARGET_ARCH)/bin:$(PATH)

include .applTop/config/CONFIG

APPLIC_DIR_TYPE = sys

include .applTop/config/RULES.Dirs

#PROD  = $(notdir $(shell pwd))
PROD = GNIRS2.0
TAR =	/usr/bin/tar
COMPRESS = gzip

release:
	$(RM) $(PROD).tar $(PROD).tar.gz .xfile
	find * \
	    \( -type l \
			-o -name config \
			-o -name data \
			-o -name temp \
			-o -name tar \
			-o -name db \
			-o -name core \
			-o -name epics \
	        -o -name .epics \
			-o -name .version \
			-o -name config.par \
			-o -name bin -o -name '*db' \
			-o -name 'data/*.dl' \
			-o -name 'data/*lut' \
			-o -name 'data/*pv' \
			-o -name 'UAE.dist*' \
			-o -name 'nirsLogin' \
			-o -name resource.def \
			-o -name local.vws \
			-o -name cad.rc \
			-o -name 'old*'\
	        -o -name 'O.*' \
			-o -name '*.dctsdr' \
			-o -name '#*' \
	        -o -name '*.sdrSum' \
			-o -name .applTop \
			-o -name '...*'\
	        -o -name '*%' \
			-o -name '*~' \
			-o -name '*.Z' \
			-o -name '*.gz' \
	    \) -prune -print > .xfile
#	echo 'capfast/nirsSadTop.sch' >> .xfile
#	echo 'capfast/nirsTop.sch' >> .xfile
#	echo 'CC/capfast/nirsCcSadTop.sch' >> .xfile
#	echo 'CC/capfast/nirsCcTop.sch' >> .xfile
#	find 'CC/capfast' -name '*.ps' -prune -print >> .xfile
#	echo 'WFS/capfast/nirsWfsSadTop.sch' >> .xfile
#	echo 'WFS/capfast/nirsWfsTop.sch' >> .xfile
#	find 'WFS/capfast' -name '*.ps' -prune -print >> .xfile
#	find 'data' -name '*.dl' -prune -print >> .xfile
#	find 'CC/data' -name '*.dl' -prune -print >> .xfile
#	find 'DC/data' -name '*.dl' -prune -print >> .xfile
#	find 'data' -name '*.dl' -prune -print >> .xfile
#	find 'CC/data' -name '*.dl' -prune -print >> .xfile
#	find 'DC/data' -name '*.dl' -prune -print >> .xfile
#	echo 'IS/capfast/nirsSadTop.sch' >> .xfile
#	echo 'IS/capfast/nirsTop.sch' >> .xfile
#	find 'IS/capfast' -name '*.ps' -prune -print >> .xfile
#	find 'WFS/ENG/capfast' -name '*.ps' -prune -print >> .xfile
#	echo 'WFS/ENG/capfast/atodTop.sch' >> .xfile
#	echo 'WFS/ENG/capfast/ccSimTop.sch' >> .xfile
#	echo 'WFS/ENG/capfast/ccTop.sch' >> .xfile
#	echo 'WFS/ENG/capfast/dioTop.sch' >> .xfile
#	echo 'WFS/ENG/capfast/engTop.sch' >> .xfile
#	echo 'WFS/ENG/capfast/tmpSimTop.sch' >> .xfile
#	echo 'WFS/ENG/capfast/tmpTop.sch' >> .xfile
#	echo 'WFS/ENG/capfast/wfsSimTop.sch' >> .xfile
#	echo 'WFS/ENG/capfast/wfsTop.sch' >> .xfile
	$(TAR) cvXf .xfile $(PROD).tar * .cvsignore
	$(COMPRESS) $(PROD).tar
	$(RM) .xfile

reset:
	find . -type d -name "O.*" | xargs $(RM) -r
	$(RM) -r bin data 

resetall: reset
	$(RM) config.par
	$(RM) capfast/cad.rc
	$(RM) startup/UAE.dist startup/local.vws startup/resource.def
	$(RM) -r config epics
	find . -type l | xargs $(RM) 
