# VxWorks startup script to load and execute system (iocCore) software.
# First, vxWorks startup issues:
# cd to application install directory (beware automounter problems)

cd "$(iocpath)"
pwd

shellPromptSet "gnirs(DC) -> "
< $(iocpath)/bin/$(arch)/local

#routeAdd ("140.252.23.212","140.252.31.41")# load dhs
ld </gemini/dhs/dhs/external/lib/mv2700T2/libers.o
ld </gemini/dhs/dhs/external/lib/mv2700T2/libimp.o
ld </gemini/dhs/dhs/external/lib/mv2700T2/libsds.o
ld </gemini/dhs/dhs/lib/mv2700T2/libgen.a
ld </gemini/dhs/dhs/lib/mv2700T2/libdhs.a


# global variable file
ld < ./bin/$(arch)/globals.o
ld < ./bin/$(arch)/coadGlobals.o

# load socket routines
ld <./bin/$(arch)/sockutil.o

# load time lan driver
ld <./bin/$(arch)/bc350time.o

# epics interface
ld <./bin/$(arch)/gnSocketIntrfc.o


# set database prefix
setTop("nirs:dc:","nirs:sad:dc:")


# set EPICSName to IP of gnirsdc2
#gnSetEPICSName("172.17.2.84")
gnSetEPICSName("10.1.2.84")

# coadder code
ld <./bin/$(arch)/gnDataCoAdder.o


# rpc code
ld <./bin/$(arch)/dqrpc.o
sp epdq_server


# DHS
# reggie
useDHS ("10.2.4.56", "dataServer1", 0,"ngnirsdc1")
#useDHS ("172.17.3.12", "dataServerSS", 0,"gnirsdc1")
#useDHS ("140.252.23.212", "dataServerNS", 0,"juliet2.tuc.noao.edu")

# dhs master routine
taskSpawn ( "ImpMaster", 100, 0x8, 20000, ImpMaster)

loglevel = 0

### set bancom board -> disabled for now
initTime 1

 
# start system
gnDCAStart

# start socket server
taskSpawn( "epicsServer",100,0x8,200000,epicsServer)


loglevel = 1000
