# VxWorks startup script to load and execute system (iocCore) software.
# First, vxWorks startup issues:
# cd to application install directory (beware automounter problems)
cd "$(install)"
pwd

shellPromptSet "gnirs(DC) -> "
< $(install)/bin/$(arch)/local.flex

#routeAdd ("140.252.23.212","140.252.31.41")
# load dhs
#ld </mpgf/gemini/dhs/ppc/dhs-0.19/external/lib/mv2700/libers.o
#ld </mpgf/gemini/dhs/ppc/dhs-0.19/external/lib/mv2700/libimp.o
#ld </mpgf/gemini/dhs/ppc/dhs-0.19/external/lib/mv2700/libsds.o
#ld </mpgf/gemini/dhs/ppc/dhs-0.19/lib/mv2700/libgen.a
#ld </mpgf/gemini/dhs/ppc/dhs-0.19/lib/mv2700/libdhs.a


# global variable file
ld < ./bin/$(arch)/globals.o
ld < ./bin/$(arch)/coadGlobals.o

# load socket routines
ld <./bin/$(arch)/sockutil.o

# load time lan driver
#ld <./bin/$(arch)/bc350time.o

# epics interface
ld <./bin/$(arch)/gnSocketIntrfc.o


# set database prefix
#setTop("nirs:dc:","nirs:sad:dc:")


# set 
#gnSetEPICSName("140.252.22.207")

# coadder code
ld <./bin/$(arch)/gnDataCoAdder.o


# rpc code
ld <./bin/$(arch)/dqrpc.o
#sp epdq_server

cd "./bin/$(arch)"

# DHS
# archie
#useDHS ("140.252.22.168", "dataServerNSD", 0,"juliet2.tuc.noao.edu")
#useDHS ("140.252.23.212", "dataServerNS", 0,"juliet2.tuc.noao.edu")

# dhs master routine
#taskSpawn ( "ImpMaster", 100, 0x8, 20000, ImpMaster)

loglevel = 0

### set bancom board -> disabled for now
## initTime 1

 
# start system
#gnDCAStart

# start socket server
#taskSpawn( "epicsServer",100,0x8,200000,epicsServer)

cd "../.." 

loglevel = 1000
