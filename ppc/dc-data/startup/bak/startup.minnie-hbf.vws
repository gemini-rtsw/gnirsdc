# VxWorks startup script to load and execute system (iocCore) software.
# First, vxWorks startup issues:
# cd to application install directory (beware automounter problems)
cd "$(install)"
pwd

shellPromptSet "minnie(mk) -> "

# The local file contains site-specific information
< ./bin/$(arch)/local

# time environment variables
putenv("DAYLIGHT=XFALSE")
putenv("TIMEZONE=-10")
putenv("SERVER=10.2.2.57")

hostAdd ("mko-dc-ctrl-niri","10.2.2.118")
# this seems to help ...
routeAdd ("10.2.4.56","10.2.2.1")
routeAdd ("10.2.2.118","10.2.2.1")

hostAdd ("mko-cc-niri","10.2.2.116")
routeAdd ("10.2.2.116","10.2.2.1")

hostAdd ("tcs","10.2.2.104")
routeAdd ("10.2.2.104","10.2.2.1")


hostAdd ("acamar","10.1.5.83")
routeAdd ("10.1.5.83","10.2.2.1")
	
# load dhs
# ld </gemini/dhs/external/lib/$(arch)/libers.o
# ld </gemini/dhs/external/lib/$(arch)/libimp.o
# ld </gemini/dhs/external/lib/$(arch)/libsds.o
# ld </gemini/dhs/lib/$(arch)/libgen.a
# ld </gemini/dhs/lib/$(arch)/libdhs.a

ld </gemini/dhs/external/lib/mv2700/libers.o
ld </gemini/dhs/external/lib/mv2700/libimp.o
ld </gemini/dhs/external/lib/mv2700/libsds.o
ld </gemini/dhs/lib/mv2700/libgen.a
ld </gemini/dhs/lib/mv2700/libdhs.a


# global variable file
ld < ./bin/$(arch)/globals.o
ld < ./bin/$(arch)/coadGlobals.o

# load socket routines
ld <./bin/$(arch)/sockutil.o

# load time lan driver
ld <./bin/$(arch)/bc350time.o

# epics interface
ld <./bin/$(arch)/gnSocketIntrfc.o


# set database prefix
setTop("niri:dc:","niri:dc:sad:")


# set 
gnSetEPICSName("10.2.2.118")

# coadder code
ld <./bin/$(arch)/gnDataCoAdder.o


# rpc code
ld <./bin/$(arch)/dqrpc.o
sp epdq_server

cd "./bin/$(arch)"

# DHS
# archie
# useDHS ("10.2.4.56", "dataServerNS", 0,"mko-dc-data-niri")
# acamar
useDHS ("10.1.5.83", "dataServerNS", 0,"mko-dc-data-niri")

# dhs master routine
taskSpawn ( "ImpMaster", 100, 0x8, 20000, ImpMaster)

loglevel = 0

### set bancom board -> disabled for now
## initTime 1

 
# start system
gnDCAStart

# start socket server
sp epicsServer

cd "../.."

