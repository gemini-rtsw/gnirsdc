# VxWorks startup script to load and execute system (iocCore) software.
# First, vxWorks startup issues:
# cd to application install directory (beware automounter problems)
cd "$(install)"
pwd

shellPromptSet "minnie-> "

# The local file contains site-specific information
< ./bin/$(arch)/local

# global variable file
ld < ./bin/$(arch)/globals.o
ld < ./bin/$(arch)/coadGlobals.o


# load socket routines
ld <./bin/$(arch)/sockutil.o

# load time lan driver
ld <./bin/$(arch)/bc350time.o

# epics interface
ld <./bin/$(arch)/gnSocketIntrfc.o

#time environment variables
putenv("DAYLIGHT=XFALSE")
putenv("TIMEZONE=-10")
#putenv("SERVER=128.171.162.216")
putenv("SERVER=10.1.5.10")

# hosts
hostAdd ("mickey","10.1.5.69")

	
#database prefix
setTop("niri:dc:","niri:dc:sad:")

#load dhs version 16
ld </gemini/dhs/external/lib/$(arch)/libers.o
ld </gemini/dhs/external/lib/$(arch)/libimp.o
ld </gemini/dhs/external/lib/$(arch)/libsds.o
ld </gemini/dhs/lib/$(arch)/libgen.a
ld </gemini/dhs/lib/$(arch)/libdhs.a


# saver files
ld <./bin/$(arch)/dcSaver.o

# coadder code
ld <./bin/$(arch)/gnDataCoAdder.o

#rpc code
ld <./bin/$(arch)/dqrpc.o


## taskSpawn ( "tt", 100, 0x8, 40000,pokeloopA16D32,0x8000)
