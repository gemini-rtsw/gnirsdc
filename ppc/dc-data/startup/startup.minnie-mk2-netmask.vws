# VxWorks startup script to load and execute system (iocCore) software.
# First, vxWorks startup issues:
# cd to application install directory (beware automounter problems)
cd "$(install)"
pwd

shellPromptSet "minnie(mk) -> "

# load the iocCore !!!

ld < /usr/local/epics/t1.0.1/epics3.13.4GEM7/base/bin/ppc604/iocCore

# putenv "EPICS_CA_ADDR_LIST=10.2.2.116 10.2.2.118 10.2.2.104"
putenv "EPICS_CA_ADDR_LIST=10.2.2.255"
putenv "EPICS_CA_CONN_TMO=30.0"
putenv "EPICS_CA_BEACON_PERIOD=15.0"
putenv "EPICS_CA_AUTO_ADDR_LIST=YES"
putenv "EPICS_CA_REPEATER_PORT=5065"
putenv "EPICS_CA_SERVER_PORT=5064"
putenv "EPICS_TS_MIN_WEST=0.0"
putenv "EPICS_TS_NTP_INET=10.2.2.57"
putenv "EPICS_IOC_LOG_PORT=7004"
putenv "EPICS_IOC_LOG_INET=10.2.2.57"
putenv "EPICS_IOC_LOG_FILE_LIMIT=1000000"
putenv "EPICS_IOC_LOG_FILE_NAME=/tmp/iocLog.text"
iocLogDisable=1

# The local file contains site-specific information
< ./bin/$(arch)/local

# time environment variables
putenv("DAYLIGHT=XFALSE")
putenv("TIMEZONE=-10")
putenv("SERVER=10.2.2.57")

hostAdd ("mko-dc-ctrl-niri","10.2.2.118")
# this seems to help ...
routeAdd ("10.2.4.56","10.2.2.1")
routeAdd ("10.2.2.118","10.2.2.1")

hostAdd ("mko-cc-niri","10.2.2.116")
routeAdd ("10.2.2.116","10.2.2.1")

hostAdd ("tcs","10.2.2.104")
routeAdd ("10.2.2.104","10.2.2.1")

	
# load dhs
ld </gemini/dhs-0.18/external/lib/$(arch)/libers.o
ld </gemini/dhs-0.18/external/lib/$(arch)/libimp.o
ld </gemini/dhs-0.18/external/lib/$(arch)/libsds.o
ld </gemini/dhs-0.18/lib/$(arch)/libgen.a
ld </gemini/dhs-0.18/lib/$(arch)/libdhs.a


# global variable file
ld < ./bin/$(arch)/globals.o
ld < ./bin/$(arch)/coadGlobals.o

# load socket routines
ld <./bin/$(arch)/sockutil.o

# load time lan driver
ld <./bin/$(arch)/bc350time.o

# epics interface
ld <./bin/$(arch)/gnSocketIntrfc.o


# set database prefix
setTop("niri:dc:","niri:dc:sad:")


# set 
gnSetEPICSName("10.2.2.118")

# coadder code
ld <./bin/$(arch)/gnDataCoAdder.o


# rpc code
ld <./bin/$(arch)/dqrpc.o
sp epdq_server

# DHS
# archie
useDHS ("10.2.4.56", "dataServerNS", 0,"mko-dc-data-niri")

# dhs master routine
taskSpawn ( "ImpMaster", 100, 0x8, 20000, ImpMaster)

loglevel = 0

# set bancom board
initTime 1

 
# start system
gnDCAStart

# start socket server
sp epicsServer

sp caMonitor,"calist"
